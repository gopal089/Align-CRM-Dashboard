# Server-side only. Supabase provides these three variables in hosted Edge Functions.
# Local development: obtain values from `supabase status` for your LOCAL project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated exact frontend origins; no trailing slash. Add your deployed HTTPS origin.
SECURITY_ALLOWED_ORIGINS=http://127.0.0.1:5173
